# backend/.env
APP_NAME=Weatherly API
APP_VERSION=2.0.0
ENVIRONMENT=production

DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

REDIS_URL=
REDIS_MAX_CONNECTIONS=20
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

CORS_ORIGINS=https://getweatherly.vercel.app
RATE_LIMIT_PER_MINUTE=120

CACHE_TTL_CURRENT=300
CACHE_TTL_FORECAST=1800
CACHE_TTL_LOCATION=86400
CACHE_TTL_ALERTS=60

COPERNICUS_API_KEY=
NOAA_API_KEY=
OPENWEATHERMAP_API_KEY=
TOMORROW_IO_API_KEY=
WEATHERAPI_API_KEY=

LOG_LEVEL=INFO
LOG_JSON_FORMAT=true

API_KEY=
TRUSTED_PROXY_COUNT=1
ALLOWED_HOSTS=getweatherly.onrender.com

APP_UPDATE_ENABLED=true
APP_LATEST_VERSION=
APP_LATEST_BUILD_NUMBER=
APP_MIN_VERSION=
APP_FORCE_UPDATE=false
APP_APK_URL=
APP_APK_SHA256=
APP_APK_SIZE_BYTES=
APP_CHANGELOG=
APP_RELEASED_AT=
APP_UPDATE_RATE_LIMIT_PER_MINUTE=30